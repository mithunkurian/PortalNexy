# Copy to trading_backend/.env.forward. All values below are credential-free.
# This service never reads the old .env or LIVE_* / PAPER_* settings.
FORWARD_EXPERIMENT=forward-v1
FORWARD_FIREBASE_CREDENTIALS=
FORWARD_IB_HOST=127.0.0.1
FORWARD_IB_PORT=7497
FORWARD_IB_CLIENT_ID=71
# Exact DU paper account ID, verified in Gateway, and explicit comma-separated allowlist.
FORWARD_IB_ACCOUNT=
FORWARD_IB_PAPER_ALLOWLIST=
# Explicit USD allocation, no leverage. Must fit actual USD paper cash.
FORWARD_ETF_USD=0
# Direct crypto adapter uses ONLY https://paper-api.alpaca.markets.
# Use the paper account UUID reported by GET /v2/account, not the account number.
FORWARD_ALPACA_ACCOUNT=
FORWARD_ALPACA_PAPER_ALLOWLIST=
FORWARD_ALPACA_KEY=
FORWARD_ALPACA_SECRET=
FORWARD_CRYPTO_USD=0
